# Copy to .env and fill the key privately. Never commit .env.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_EXTRA_BODY={"reasoning_effort":"low"}

# Optional backup must also be a real LLM. Blank disables it.
BACKUP_LLM_PROVIDER=
BACKUP_LLM_MODEL=
BACKUP_LLM_API_KEY=
BACKUP_LLM_BASE_URL=
BACKUP_LLM_EXTRA_BODY=

# Required only for LLM_PROVIDER=custom (OpenAI-compatible /chat/completions).
LLM_BASE_URL=
LLM_TIMEOUT_S=8
LLM_MAX_TRIES=2
INTERPRET_BUDGET_S=20
NOTE_CACHE_SIZE=2048
PORT=8000
LOG_LEVEL=INFO
